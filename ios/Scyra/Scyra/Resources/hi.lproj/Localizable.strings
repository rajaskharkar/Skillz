"help_page_flow_kicker" = "फ़्लो";
"help_page_flow_title" = "एक फ़्लो एक केंद्रित सत्र है।";
"help_page_flow_subtitle" = "जब आप किसी महत्वपूर्ण चीज़ पर इरादे से समय देना चाहें, तब फ़्लो शुरू करें।";
"help_page_flow_body" = "एक फ़्लो आपका समय ट्रैक करता है, सत्र को पृष्ठभूमि में जीवित रखता है, और आपको नोट्स जोड़ने देता है ताकि आपका काम आपकी स्टोरी का हिस्सा बन जाए। हर फ़्लो प्रयास का एक स्पष्ट और उद्देश्यपूर्ण अध्याय है।";
"help_page_flow_tip" = "फ़्लो का उपयोग गहरे काम, अभ्यास, पढ़ाई, लेखन, कसरत या किसी भी ऐसे काम के लिए करें जिसे आप इरादे से करना चाहते हैं।";
"help_page_soft_flow_kicker" = "सॉफ्ट फ़्लो";
"help_page_soft_flow_title" = "सॉफ्ट फ़्लो एक अधिक सौम्य सत्र है।";
"help_page_soft_flow_subtitle" = "सॉफ्ट फ़्लो तब उपयोग करें जब आप किसी गतिविधि में उपस्थित रहना चाहते हों, पर उसे स्कोर की दौड़ में बदलना न चाहते हों।";
"help_page_soft_flow_body" = "सॉफ्ट फ़्लो समय ट्रैक करता है और क्षण को आपकी स्टोरी का हिस्सा बनने देता है, लेकिन स्कोर नहीं देता। यह शांत सत्रों के लिए बनाया गया है जहाँ लक्ष्य बस उपस्थित होना, साँस लेना, पुनर्प्राप्ति करना, चिंतन करना, या बिना दबाव के धीरे-धीरे आगे बढ़ना हो।";
"help_page_soft_flow_tip" = "सॉफ्ट फ़्लो का उपयोग वॉक, स्ट्रेचिंग, जर्नलिंग, मेडिटेशन, हल्का रीडिंग, रिकवरी समय, या किसी भी ऐसे सत्र के लिए करें जिसे आप गेमिफ़ाई किए बिना सम्मान देना चाहते हों।";
"help_page_pulse_kicker" = "पल्स";
"help_page_pulse_title" = "एक पल्स किसी क्षण का त्वरित लेखा है।";
"help_page_pulse_subtitle" = "जब आप कोई छोटी, अर्थपूर्ण, या तात्कालिक चीज़ कैप्चर करना चाहें बिना पूरा फ़्लो शुरू किए, तब पल्स उपयोग करें।";
"help_page_pulse_body" = "एक पल्स आपको कुछ सेकंड में कोई विचार, भावना, बोध, घटना, या छोटी सफलता रिकॉर्ड करने में मदद करता है। यह फ़्लो से हल्का है, लेकिन फिर भी आपकी स्टोरी का हिस्सा बन जाता है, जिससे आप उन क्षणों को याद रख पाते हैं जिन्होंने आपके दिन को आकार दिया।";
"help_page_pulse_tip" = "पल्स का उपयोग त्वरित चिंतन, आइडिया, ब्रेकथ्रू, भावनाएँ, चेक-इन, या छोटे क्षण के लिए करें जिन्हें आप खोना नहीं चाहते।";
"help_page_arc_kicker" = "आर्क";
"help_page_arc_title" = "आर्क निरंतरता को रिवॉर्ड करते हैं।";
"help_page_arc_subtitle" = "जब आप लगातार फ़्लो के बीच गति बनाए रखते हैं, तब आर्क बनता है।";
"help_page_arc_body" = "जारी रखें और आपका आर्क बढ़ता जाएगा। 10 मिनट या अधिक के हर पूरे फ़्लो के बाद आर्क गुणक +0.1 बढ़ता है। फ़्लो के बीच छोटी छूट अवधि होती है, इसलिए जल्दी जारी रखने से कड़ी बनी रहती है।";
"help_page_arc_tip" = "आर्क को सत्रों के बीच गति की तरह सोचें। फ़्लो सहेजें, जारी रखें, और कड़ी को जीवित रखें।";
"help_page_surge_kicker" = "सर्ज";
"help_page_surge_title" = "सर्ज सटीकता को रिवॉर्ड करता है।";
"help_page_surge_subtitle" = "शुरू करने से पहले एक लक्षित अवधि सेट करें और उसके करीब समाप्त करने की कोशिश करें।";
"help_page_surge_body" = "सर्ज उन सत्रों के लिए है जहाँ आप किसी निश्चित समय के लिए प्रतिबद्धता करना चाहते हैं। आपकी मौजूदा सेशन जितनी योजित अवधि के करीब होगी, रिवॉर्ड उतना बेहतर होगा। यह नियंत्रण और इरादतन क्रियान्वयन की संतोषजनक भावना जोड़ता है।";
"help_page_surge_tip" = "सर्ज का उपयोग तब करें जब आपको स्पष्ट मिशन चाहिए हो, जैसे 20 मिनट पढ़ना, 45 मिनट कोडिंग करना, या 30 मिनट अभ्यास करना।";
