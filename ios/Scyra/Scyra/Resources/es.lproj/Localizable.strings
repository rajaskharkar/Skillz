"help_page_flow_kicker" = "Flow";
"help_page_flow_title" = "Un Flow es una sesión enfocada.";
"help_page_flow_subtitle" = "Inicia un Flow cuando quieras dedicar tiempo intencionalmente a algo que importa.";
"help_page_flow_body" = "Un Flow registra tu tiempo, mantiene viva la sesión en segundo plano y te permite añadir notas para que el trabajo se convierta en parte de tu Story. Cada Flow es un capítulo limpio y deliberado de esfuerzo.";
"help_page_flow_tip" = "Usa Flow para trabajo profundo, práctica, estudio, escritura, entrenamientos o cualquier cosa que quieras hacer con intención.";
"help_page_soft_flow_kicker" = "Soft Flow";
"help_page_soft_flow_title" = "Soft Flow es una sesión más suave.";
"help_page_soft_flow_subtitle" = "Usa Soft Flow cuando quieras estar presente en una actividad sin convertirla en una búsqueda de puntuación.";
"help_page_soft_flow_body" = "Soft Flow sigue registrando el tiempo y permite que el momento forme parte de tu Story, pero no otorga puntuación. Está diseñado para sesiones más tranquilas en las que el objetivo es simplemente presentarte, respirar, recuperarte, reflexionar o moverte con suavidad y sin presión.";
"help_page_soft_flow_tip" = "Usa Soft Flow para caminatas, estiramientos, journaling, meditación, lectura ligera, tiempo de recuperación o cualquier sesión que quieras honrar sin gamificar.";
"help_page_pulse_kicker" = "Pulse";
"help_page_pulse_title" = "Un Pulse es un registro rápido de un momento.";
"help_page_pulse_subtitle" = "Usa un Pulse cuando quieras capturar algo pequeño, significativo o inmediato sin iniciar un Flow completo.";
"help_page_pulse_body" = "Un Pulse te ayuda a registrar un pensamiento, emoción, realización, evento o microvictoria en segundos. Es más ligero que un Flow, pero igualmente pasa a formar parte de tu Story, ayudándote a recordar los momentos que dieron forma a tu día.";
"help_page_pulse_tip" = "Usa Pulse para reflexiones rápidas, ideas, avances, emociones, check-ins o pequeños momentos que no quieras perder.";
"help_page_arc_kicker" = "Arc";
"help_page_arc_title" = "Los Arcs recompensan la continuidad.";
"help_page_arc_subtitle" = "Un Arc se forma cuando mantienes tu impulso a lo largo de Flows consecutivos.";
"help_page_arc_body" = "Sigue adelante y tu Arc crecerá. Después de cada Flow completado de 10 minutos o más, el multiplicador del Arc aumenta +0.1. Tienes una breve ventana de gracia entre Flows, así que continuar rápido ayuda a preservar la cadena.";
"help_page_arc_tip" = "Piensa en un Arc como el impulso a través de sesiones. Guarda el Flow, continúa y mantén viva la cadena.";
"help_page_surge_kicker" = "Surge";
"help_page_surge_title" = "Surge recompensa la precisión.";
"help_page_surge_subtitle" = "Establece una duración objetivo antes de empezar e intenta terminar cerca de ella.";
"help_page_surge_body" = "Surge es para sesiones en las que quieres comprometerte con una cantidad específica de tiempo. Cuanto más se acerque tu sesión real a la duración planificada, mejor será la recompensa. Añade una sensación satisfactoria de control y ejecución intencional.";
"help_page_surge_tip" = "Usa Surge cuando quieras una misión clara, como 20 minutos de lectura, 45 minutos de programación o 30 minutos de práctica.";
