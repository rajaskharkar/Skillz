"help_page_flow_kicker" = "फ्लो";
"help_page_flow_title" = "फ्लो म्हणजे एक केंद्रित सत्र.";
"help_page_flow_subtitle" = "जेव्हा तुम्हाला महत्त्वाच्या गोष्टीवर हेतुपुरस्सर वेळ द्यायचा असेल तेव्हा फ्लो सुरू करा.";
"help_page_flow_body" = "फ्लो तुमचा वेळ नोंदवतो, सत्र पार्श्वभूमीत चालू ठेवतो आणि नोट्स जोडू देतो, त्यामुळे तुमचे काम तुमच्या कथेत सामील होते. प्रत्येक फ्लो हा प्रयत्नाचा स्वच्छ, जाणीवपूर्वक अध्याय असतो.";
"help_page_flow_tip" = "गंभीर काम, सराव, अभ्यास, लेखन, व्यायाम किंवा ज्या कोणत्याही गोष्टीसाठी तुम्हाला जाणीवपूर्वक वेळ द्यायचा आहे त्यासाठी फ्लो वापरा.";
"help_page_soft_flow_kicker" = "सॉफ्ट फ्लो";
"help_page_soft_flow_title" = "सॉफ्ट फ्लो हे अधिक सौम्य सत्र आहे.";
"help_page_soft_flow_subtitle" = "जेव्हा तुम्हाला एखाद्या क्रियेत उपस्थित राहायचे असते पण तिला गुणांच्या धावपळीत बदलायचे नसते, तेव्हा सॉफ्ट फ्लो वापरा.";
"help_page_soft_flow_body" = "सॉफ्ट फ्लो वेळ नोंदवतो आणि त्या क्षणाला तुमच्या कथेत स्थान देतो, पण स्कोअर देत नाही. हा शांत सत्रांसाठी तयार केला आहे, जिथे उद्दिष्ट फक्त उपस्थित राहणे, श्वास घेणे, पुनर्प्राप्ती करणे, चिंतन करणे किंवा कोणत्याही दबावाशिवाय हलकेपणे हालचाल करणे असते.";
"help_page_soft_flow_tip" = "चालणे, स्ट्रेचिंग, जर्नलिंग, ध्यान, हलके वाचन, रिकव्हरी वेळ किंवा ज्या सत्राला तुम्ही गेमिफाय न करता सन्मान द्यायचा आहे त्यासाठी सॉफ्ट फ्लो वापरा.";
"help_page_pulse_kicker" = "पल्स";
"help_page_pulse_title" = "पल्स म्हणजे क्षणाची जलद नोंद.";
"help_page_pulse_subtitle" = "पूर्ण फ्लो सुरू न करता एखादी लहान, अर्थपूर्ण किंवा तत्काळ गोष्ट टिपायची असेल तर पल्स वापरा.";
"help_page_pulse_body" = "पल्स तुम्हाला विचार, भावना, जाणीव, घटना किंवा छोटा विजय काही सेकंदात नोंदवायला मदत करतो. तो फ्लो पेक्षा हलका आहे, पण तरीही तुमच्या कथेत सामील होतो आणि दिवस घडवणारे क्षण लक्षात ठेवायला मदत करतो.";
"help_page_pulse_tip" = "जलद चिंतन, कल्पना, ब्रेकथ्रू, भावना, चेक-इन किंवा हरवू नये असे छोटे क्षण यासाठी पल्स वापरा.";
"help_page_arc_kicker" = "आर्क";
"help_page_arc_title" = "आर्क सातत्याला बक्षीस देतात.";
"help_page_arc_subtitle" = "जेव्हा तुम्ही सलग फ्लो ंमधून तुमची गती टिकवता तेव्हा आर्क तयार होतो.";
"help_page_arc_body" = "सुरू ठेवा आणि तुमचा आर्क वाढत जाईल. 10 मिनिटे किंवा अधिकच्या प्रत्येक पूर्ण फ्लो नंतर आर्क गुणक +0.1 ने वाढतो. फ्लो ंदरम्यान छोटी सवलत खिडकी असते, त्यामुळे पटकन पुढे गेल्यास साखळी टिकते.";
"help_page_arc_tip" = "आर्क म्हणजे सत्रांमधील गती असे समजा. फ्लो जतन करा, पुढे चालू ठेवा आणि साखळी जिवंत ठेवा.";
"help_page_surge_kicker" = "सर्ज";
"help_page_surge_title" = "सर्ज अचूकतेला बक्षीस देते.";
"help_page_surge_subtitle" = "सुरू करण्यापूर्वी लक्ष्य कालावधी ठेवा आणि त्याच्या शक्य तितक्या जवळ पूर्ण करण्याचा प्रयत्न करा.";
"help_page_surge_body" = "सर्ज त्या सत्रांसाठी आहे जिथे तुम्हाला विशिष्ट वेळेची बांधिलकी घ्यायची असते. प्रत्यक्ष सत्र लक्ष्य कालावधीच्या जितके जवळ, तितके अधिक बक्षीस. हे नियंत्रण आणि जाणीवपूर्वक अंमलबजावणीची समाधानकारक भावना देते.";
"help_page_surge_tip" = "20 मिनिटांचे वाचन, 45 मिनिटांचे कोडिंग किंवा 30 मिनिटांचा सराव अशा स्पष्ट मिशनसाठी सर्ज वापरा.";
