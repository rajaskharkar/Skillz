<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="skillz_db"/>
        <exclude domain="database" path="skillz_db-shm"/>
        <exclude domain="database" path="skillz_db-wal"/>
        <exclude domain="file" path="chronicle/"/>
    </cloud-backup>
    <!-- Omitting device-transfer rules retains normal transfer of both DB and
         durable Chronicle files, as well as unrelated application state. Cache
         staging is outside Android backup/transfer domains. -->
</data-extraction-rules>
